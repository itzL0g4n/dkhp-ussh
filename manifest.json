{
  "manifest_version": 3,
  "name": "USSH Sniper - Công Cụ Đăng Ký Lớp Học",
  "version": "4.0.0",
  "description": "Công cụ tự động săn slot đăng ký lớp học USSH (v4 với Tự Động Phát Hiện Lớp)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://hcmussh.edu.vn/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://hcmussh.edu.vn/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "USSH Sniper - Công Cụ Đăng Ký Lớp"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
